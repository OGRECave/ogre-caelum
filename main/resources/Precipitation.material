fragment_program Caelum/PrecipitationFP glsl glsles glslang hlsl
{
	source Precipitation.frag
	target ps_3_0

	default_params
	{
		param_named scene int 0
		param_named samplerPrec int 1
	}
}

material Caelum/PrecipitationMaterial
{
	technique Default
	{
		pass Main
		{			
			vertex_program_ref Caelum/MinimalCompositorVP
			{
			}
			
			fragment_program_ref Caelum/PrecipitationFP
			{
			}
			
			texture_unit Scene
			{			
			}
			
			texture_unit Precipitation
			{
                texture precipitation_drizzle.png
                filtering trilinear
			}
		}
	}
}
