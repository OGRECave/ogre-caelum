vertex_program CaelumSunVP glsl glsles glslang hlsl
{
    source Sun.vert
    target vs_3_0

    default_params
    {
        param_named_auto worldviewproj_matrix worldviewproj_matrix
    }
}

fragment_program CaelumSunFP glsl glsles glslang hlsl
{
    source Sun.frag
    target ps_3_0

    default_params
    {
        param_named sunDisc int 0
    }
}

material CaelumSpriteSun
{
    receive_shadows off
    technique Default
    {
        pass Main
        {
            lighting off
            depth_check off
            depth_write off
            fog_override true none

            // Additive, scaled by the fragment alpha. The disc texture is
            // white even in its transparent texels, so `scene_blend add`
            // would render a white square.
            scene_blend src_alpha one

            vertex_program_ref CaelumSunVP
            {
            }

            fragment_program_ref CaelumSunFP
            {
            }

            texture_unit Texture0
            {
                texture sun_disc.png 2d 0
            }
        }
    }
}
