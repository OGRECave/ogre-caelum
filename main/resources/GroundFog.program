vertex_program CaelumGroundFogVP glsl glsles glslang hlsl
{
	source GroundFog.vert
	target vs_3_0

	default_params
	{
		param_named_auto worldViewProj worldviewproj_matrix
		param_named_auto world world_matrix
	}
}

fragment_program CaelumGroundFogFP glsl glsles glslang hlsl
{
	source GroundFog.frag
	target ps_3_0
	
	default_params
	{
		param_named_auto camPos camera_position
		
		// _auto seems wrong here, since the fog formulas are different than
		// for standard exp fog.
		param_named fogDensity float 0
		param_named fogVerticalDecay float 0
		param_named fogGroundLevel float 0
		param_named fogColour float4 0 0 0 0
	}
}

vertex_program CaelumGroundFogDomeVP glsl glsles glslang hlsl
{
	source GroundFogDome.vert
	target vs_3_0
	
	default_params
	{
		param_named_auto worldViewProj worldviewproj_matrix
	}
}

fragment_program CaelumGroundFogDomeFP glsl glsles glslang hlsl
{
	source GroundFogDome.frag
	target ps_3_0

	default_params
	{
		// Fog parameters.
		param_named fogColour float4 0 0 0 0
		param_named fogDensity float 0
		param_named fogVerticalDecay float 0
		param_named fogGroundLevel float 0
		
		// Send camera height. We can't send camera_position because
		// the entity is always moved with the camera. Joy.
		param_named cameraHeight float 0
	}
}