compositor Caelum/DepthComposer_DebugDepthRender
{
    technique
    {
        // colour and depth of the original scene
        // DEPTH16 for OpenGL support; make sure the camera clip distances allow for the precision
        texture rt0 target_width target_height PF_A8R8G8B8 PF_DEPTH16

        target rt0
        {
            input previous
        }

        target_output
        {
            input none

            pass render_quad
            {
                material Caelum/DepthComposer_DebugDepthRender
                input 0 rt0 0
                input 1 rt0 1
            }
        }
    }
}

