vertex_program CaelumHazeVP glsl glsles glslang hlsl
{
	source Haze.vert
	target vs_3_0

	default_params
	{
		param_named_auto worldViewProj worldviewproj_matrix
		param_named_auto camPos camera_position
	}
}

fragment_program CaelumHazeFP glsl glsles glslang hlsl
{
	source Haze.frag
	target ps_3_0

	default_params
	{
		param_named atmRelativeDepth int 0
		param_named_auto fogColour fog_colour
	}
}
