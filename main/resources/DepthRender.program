vertex_program Caelum/DepthRenderVP glsl glsles glslang hlsl
{
    source DepthRender.vert
    target vs_3_0

    default_params
    {
        param_named_auto wvpMatrix worldviewproj_matrix
    }
}

fragment_program Caelum/DepthRenderFP glsl glsles glslang hlsl
{
    source DepthRender.frag
    target ps_3_0
}

vertex_program Caelum/DepthRenderAlphaRejectionVP glsl glsles glslang hlsl
{
    source DepthRender.vert
    target vs_3_0
    preprocessor_defines ALPHA_REJECTION

    default_params
    {
        param_named_auto wvpMatrix worldviewproj_matrix
    }
}

fragment_program Caelum/DepthRenderAlphaRejectionFP glsl glsles glslang hlsl
{
    source DepthRender.frag
    target ps_3_0
    preprocessor_defines ALPHA_REJECTION

    default_params
    {
        param_named mainTex int 0
    }
}
